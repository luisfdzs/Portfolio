# Copia este fichero a .env.local y rellena los valores.
# .env.local está gitignorado: NUNCA se sube al repositorio.
#
# NADA DE ESTO ES OBLIGATORIO para arrancar. Sin variables de Sanity la web se
# construye igual, leyendo el contenido de `content/` (ver lib/content.ts). Las
# variables sólo hacen falta para editar desde el panel de /admin.

# --- Sanity (panel de administración) ---
# projectId y dataset NO son secretos: van en el HTML de cualquier web con Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token de ESCRITURA. No hace falta para la importación inicial (el CLI usa tu sesión
# de `sanity login`); se deja declarado por si algún script necesita escribir.
# Se crea en sanity.io/manage › API › Tokens con permiso "Editor". Es un secreto.
SANITY_API_WRITE_TOKEN=

# Secreto compartido con el webhook de Sanity que revalida la web al publicar.
# Cualquier cadena larga y aleatoria; el mismo valor va en sanity.io/manage › API › Webhooks.
SANITY_REVALIDATE_SECRET=
